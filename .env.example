# Copy to .env and fill real keys. .env is gitignored — never commit secrets.
# LLM Provider: groq | openai | openrouter. Set only the key for the selected provider.
LLM_PROVIDER=openrouter
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Optional alternative provider key; leave empty when using OpenRouter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# App
APP_ENV=development
APP_PORT=8000
FRONTEND_PORT=3000
SECRET_KEY=change-this-to-a-long-random-secret
API_KEY=change-this-to-a-long-random-api-key
CORS_ORIGINS=http://localhost:3000

# Database — local/tests use SQLite; Docker/production use PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./disputeflow.db
CHECKPOINT_DATABASE_URL=

# ML — default model is trained on synthetic heuristic labels, not issuer outcomes
# Production must use the trained artifact; development may opt into the fallback.
ALLOW_HEURISTIC_MODEL=false
MODEL_PATH=backend/data/models/win_probability_model.pkl
AUTO_APPROVE_HUMAN_REVIEW=true
MIN_REAL_TRAINING_ROWS=50
# DISPUTEFLOW_AUTO_RETRAIN=0

# GitHub dispute intake (production source of truth)
DISPUTE_SOURCE=github
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-dispute-cases-repository
GITHUB_REF=main
GITHUB_INPUT_PATH=disputes/input
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=
# Optional fallback if OWNER/REPO are unset:
GITHUB_REPO_URL=https://github.com/your-github-username/your-dispute-cases-repository

# Credentials required only if you separately run the imported Stripe
# dispute-automation reference. DisputeFlow itself uses OpenRouter above.
STRIPE_API_KEY=your_restricted_stripe_key_here
POSTHOG_API_KEY=your_posthog_api_key_here
POSTHOG_PROJECT_ID=your_posthog_project_id_here
POSTHOG_HOST=https://us.posthog.com
RESEND_API_KEY=your_resend_api_key_here
GMAIL_CREDENTIALS_PATH=./secrets/gmail_credentials.json
GMAIL_TOKEN_PATH=./secrets/gmail_token.json
GMAIL_SUPPORT_LABEL=
EVIDENCE_DIR=./evidence
BUSINESS_NAME=Your Company
BUSINESS_DOMAINS=example.com
TERMS_URL=https://example.com/terms-and-conditions
PRICING_URL=https://example.com/
PRODUCT_DESCRIPTION=Describe the product or service being disputed.
